<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Yinian" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/paper_dark</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="28">shortEdges</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
        <item name="android:colorAccent">@color/seal</item>
    </style>

    <style name="Theme.Yinian.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/paper_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="windowSplashScreenAnimationDuration">220</item>
        <item name="postSplashScreenTheme">@style/Theme.Yinian</item>
    </style>
</resources>
